        "commandPath": "node -e 'let d=``;process.stdin.on(`data`,c=>d+=c).on(`end`,()=>{try{const w=JSON.parse(d).rate_limits?.seven_day;if(!w||w.resets_at==null)return process.stdout.write(``);const used=w.utilization??w.used_percentage??0,win=604800,now=Date.now()/1e3,el=win-(w.resets_at-now),est=el>0?used*win/el:used;process.stdout.write(`Est: `+Math.round(est)+`%`);}catch(e){process.stdout.write(``);}})'",
        "timeout": 3000
      }
